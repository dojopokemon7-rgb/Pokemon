# =============================================================
# PRODUCTION .env — DigitalOcean Droplet (Phase 1: HTTP on IP, no domain yet)
# =============================================================
# Copy this to `.env` ON THE DROPLET and fill in the blanks marked <FILL>.
# NEVER commit the filled-in version. The Mumbai DB URLs are pre-filled.
#
# PHASE 1 (now): DOMAIN left blank -> Caddy serves plain HTTP on :80 at the
#   Droplet IP. Reach the app at http://<DROPLET_IP>.
# PHASE 2 (later): set DOMAIN=yourdomain.com, point its DNS A record at the
#   Droplet IP, then `docker compose up -d` again -> Caddy auto-provisions
#   HTTPS (Let's Encrypt) on :443. No other change needed.
# =============================================================

# ---- Database: Supabase MUMBAI (ap-south-1) — already migrated ----
# NOTE: rotate this password before real production (it was shared in chat).
DATABASE_URL="postgresql://postgres.yfvecmtihwjhsggdydkj:<DB_PASSWORD>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.yfvecmtihwjhsggdydkj:<DB_PASSWORD>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ---- Redis: the in-stack container (docker-compose provides it) ----
# The compose app service OVERRIDES REDIS_URL to redis://default:${REDIS_PASSWORD}@redis:6379,
# so you only need to set REDIS_PASSWORD here; it is injected into both the
# redis server (--requirepass) and the app's REDIS_URL.
REDIS_PASSWORD="<GENERATE_A_STRONG_PASSWORD>"

# ---- Better Auth ----
# Generate the secret ON THE DROPLET with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET="<FILL_32_BYTE_HEX>"
# Phase 1 (no domain): use the Droplet IP. Phase 2: switch to https://yourdomain.com
BETTER_AUTH_URL="http://<DROPLET_IP>"

# ---- Domain (Caddy TLS) ----
# Phase 1: leave BLANK -> Caddy serves HTTP on :80. Phase 2: set to your domain.
DOMAIN=""

# ---- Supabase public keys (Mumbai project — Settings > API) ----
NEXT_PUBLIC_SUPABASE_URL="https://yfvecmtihwjhsggdydkj.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<FILL_MUMBAI_ANON_KEY>"

# ---- Scrydex (card data / Vision OCR) ----
SCRYDEX_API_KEY="<FILL>"
SCRYDEX_TEAM_ID="<FILL>"
# Credit gates: keep these controlled. "true" lets Scrydex spend real credits.
SCRYDEX_LIVE_CREDITS_APPROVED="true"
SCRYDEX_ONVIEW_ENABLED="true"

# ---- Google OAuth (fixes the sign-in hang) ----
# In Google Cloud Console, add to the OAuth client:
#   Authorized redirect URI: http://<DROPLET_IP>/api/auth/callback/google   (Phase 1)
#     then https://yourdomain.com/api/auth/callback/google                  (Phase 2)
#   Authorized JS origin:    http://<DROPLET_IP>  (Phase 1) / https://yourdomain.com (Phase 2)
GOOGLE_CLIENT_ID="<FILL>"
GOOGLE_CLIENT_SECRET="<FILL>"

# ---- Google Vision (optional OCR fallback; blank = tesseract.js on-device) ----
GOOGLE_VISION_API_KEY=""

# ---- Daily owned-cards price refresh cron ----
CRON_SECRET="<GENERATE_A_STRONG_SECRET>"
DAILY_OWNED_PRICE_CAP="250"

# ---- Rate limiting (sensible defaults baked in; tune if needed) ----
