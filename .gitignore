# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# Next.js build output
/.next/
/out/

# Production
/build

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local env files — NEVER commit these
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Prisma
# F-#8 introduced the first REAL migration (the project previously used `db push`),
# which MUST be version-controlled. The migrations dir is no longer ignored.

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/settings.json
.idea/

# Session/cookie dumps
cookies.txt

# Reference materials & prototype (not needed for deployment)
.reference/
dojo prototype/
dojo-design/
dist/

# Playwright
/test-results/
/playwright-report/
/e2e/.auth/

# Python cache
__pycache__/
*.py[cod]
ebay_service.py
test_last_sold.py

# Local-only agent artifacts & worktrees (never push)
.agents/
.worktrees/

# Local-only throwaway scripts (Scrydex probes, DB debug, one-off pulls)
scripts/probe-*.ts
scripts/check-bgs-chips.ts
scripts/check-dashboard-transpose.ts
scripts/debug-dashboard-history.ts
scripts/pull-history-full.ts
scripts/pull-sold-listings.ts

# Local performance compose override
docker-compose.localperf.yml
