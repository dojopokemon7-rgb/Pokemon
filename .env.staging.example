# =============================================================
# TCG Collection PWA — STAGING Environment Variables Template
# Copy this file to .env.staging and fill in your actual values.
# NEVER commit .env.staging to git (only this *.example is tracked).
# =============================================================
#
# STAGING runs as the `app-staging` container on the SAME Droplet as prod,
# served at https://staging.dojocollect.com (behind Caddy basic-auth).
#
# ISOLATION FROM PROD — three things MUST differ from the prod .env:
#   1. DATABASE_URL / DIRECT_URL carry `schema=staging` (see below).
#   2. BETTER_AUTH_SECRET must be a FRESH secret (never reuse prod's).
#   3. ADMIN_SESSION_SECRET should be staging-specific (see ADMIN block).
# Google OAuth also needs the staging redirect URI registered (see GOOGLE block).
#
# HOW THE DB ISOLATION WORKS (Prisma `schema=staging`):
#   Prisma reads the target Postgres schema from the `schema=` query param on
#   the connection URL. Pointing staging at `...?schema=staging` makes the
#   migration engine auto-CREATE a `staging` schema in the SAME Supabase DB and
#   apply ALL migrations there, fully isolated from prod's implicit `public`
#   schema. No prisma/schema.prisma change is needed — only these two URLs.
#   Provision with `prisma migrate deploy` (replays the committed migration
#   history), NOT `prisma db push`. (Content rephrased for compliance.)

# -------------------------------------------------------------
# DATABASE (Supabase PostgreSQL — SAME project as prod)
# -------------------------------------------------------------
# Same Supabase pooler host/creds as prod, but append `&schema=staging` so
# Prisma targets the isolated `staging` schema (NOT prod's `public`).
# Mode: Transaction (Port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&schema=staging"

# Direct connection — used by Prisma for migrations (bypasses PgBouncer).
# Same direct host as prod + `?schema=staging`.
# Mode: Session (Port 5432)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?schema=staging"

# -------------------------------------------------------------
# REDIS (SHARED with prod — same `redis` container)
# -------------------------------------------------------------
# docker-compose.yml overrides REDIS_URL for app-staging to point at the shared
# `redis` service with the shared password, so these values are effectively
# superseded by compose. Keep REDIS_PASSWORD in sync with prod .env.
REDIS_URL="redis://redis:6379"
# STORAGE_REDIS_URL=""
# REDIS_PASSWORD=""

# -------------------------------------------------------------
# BETTER AUTH
# -------------------------------------------------------------
# MUST DIFFER FROM PROD. Generate a fresh one with: openssl rand -hex 32
# Or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET="REPLACE_WITH_A_FRESH_32_CHAR_SECRET_DIFFERENT_FROM_PROD"

# Public URL of the STAGING app (Better Auth cookies + redirects).
BETTER_AUTH_URL="https://staging.dojocollect.com"

# NOTE: the staging Caddy block uses a HARDCODED hostname
# (staging.dojocollect.com), NOT the {$DOMAIN} env indirection, so DOMAIN is
# NOT required for the staging site to serve + get a cert. The var is kept here
# only for parity with prod; leave it unset unless something else reads it.
# IMPORTANT (if ever set): keep it UNQUOTED — a quoted value is substituted
# literally. e.g.  DOMAIN=staging.dojocollect.com
# DOMAIN=

# STAGING basic-auth hash: it does NOT belong here. The caddy service is SHARED
# (one container fronts both prod + staging) and has no env_file, so compose
# interpolates ${STAGING_BASICAUTH_HASH} from the ROOT .env — NOT from this
# .env.staging — exactly like DOMAIN. Set STAGING_BASICAUTH_HASH in the root .env
# (see .env.example and docs/CLOUDFLARE_SETUP.md). Putting it here has no effect.

# Recommended for staging: app code falls back to NEXT_PUBLIC_APP_URL for
# metadata / SSR redirects, so set it to staging's own origin to keep links
# pointing at staging (not prod). This var is ABSENT from the prod .env.example
# but is honored by the app; OPTIONAL but recommended for correct staging URLs.
NEXT_PUBLIC_APP_URL="https://staging.dojocollect.com"

# PSA Public API token (F-17 graded pricing). Shareable with prod.
PSA_API_KEY=""

# -------------------------------------------------------------
# ADMIN AUTH (isolated superuser — env-defined, NOT the DB)
# -------------------------------------------------------------
# See prod .env.example for the full admin flow description. For staging:
#   - RECOMMENDED: set a staging-specific ADMIN_PASSWORD (do not reuse prod's).
#   - RECOMMENDED: set a dedicated ADMIN_SESSION_SECRET (generate with
#     `openssl rand -base64 32`) so a staging admin session can NEVER be
#     replayed against prod. If unset it falls back to BETTER_AUTH_SECRET
#     (which is already staging-specific above), but an explicit value is
#     clearer.
# Leave BLANK here — real values live in .env.staging (never committed).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# RETIRED (see prod .env.example) — unused, kept for parity.
ADMIN_INITIAL_PASSWORD=your_secure_password_here

# Signup allowlist — same semantics as prod. Consider tightening on staging if
# you don't want open signups on the pre-release env. Empty/unset = OPEN.
SIGNUP_ALLOWLIST=""

# -------------------------------------------------------------
# GOOGLE CLOUD VISION (F-14 Card Scanner OCR)
# -------------------------------------------------------------
# Shareable with prod.
GOOGLE_VISION_API_KEY=""
# SCAN_LIMIT="10"

# -------------------------------------------------------------
# SUPABASE (Client-side Storage / File Uploads)
# -------------------------------------------------------------
# Same Supabase project as prod.
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# -------------------------------------------------------------
# SMS PROVIDER (Phone OTP — disabled for MVP)
# -------------------------------------------------------------
SMS_PROVIDER_API_KEY=""
SMS_PROVIDER_BASE_URL=""
SMS_FROM_NUMBER=""

# -------------------------------------------------------------
# EMAIL PROVIDER (password-reset delivery)
# -------------------------------------------------------------
# EMAIL_FROM is SHARED with prod (dojo.collect@nodwin.com — already verified
# in SES). Reused as the SES sender below. Other provider keys shareable.
RESEND_API_KEY=""
EMAIL_FROM="dojo.collect@nodwin.com"
EMAIL_PROVIDER_API_KEY=""
EMAIL_PROVIDER_BASE_URL=""

# -------------------------------------------------------------
# AMAZON SES (email-OTP verification delivery)
# -------------------------------------------------------------
# SES config shareable with prod. EMAIL_FROM (above) is the shared, verified
# sender dojo.collect@nodwin.com. The AWS_SES_* trio is the Phase-B send path.
AWS_SES_REGION=""
AWS_SES_ACCESS_KEY_ID=""
AWS_SES_SECRET_ACCESS_KEY=""
# EMAIL_FROM — see the EMAIL PROVIDER block above; reused as the SES sender.

# -------------------------------------------------------------
# APITCG (Real One Piece card data)
# -------------------------------------------------------------
# Shareable with prod.
APITCG_API_KEY=""

# -------------------------------------------------------------
# eBay Sandbox / Production API (Price Comparison & Deal Finder)
# -------------------------------------------------------------
# Shareable with prod.
EBAY_CLIENT_ID=""
EBAY_CLIENT_SECRET=""
EBAY_DEV_ID=""
EBAY_RU_NAME=""
EBAY_API_URL="https://api.sandbox.ebay.com"

# -------------------------------------------------------------
# CRON JOBS
# -------------------------------------------------------------
# Only relevant on Vercel. Generate with: openssl rand -hex 32
CRON_SECRET=""
DAILY_OWNED_PRICE_CAP=""

# -------------------------------------------------------------
# POKEMON TCG API (Daily Sync Engine)
# -------------------------------------------------------------
# Shareable with prod.
POKEMON_TCG_API_KEY=""

# -------------------------------------------------------------
# POKEWALLET & SCRYDEX (API Integrations)
# -------------------------------------------------------------
# Scrydex keys are SHAREABLE with prod — BUT staging shares the live Scrydex
# ACCOUNT and its CREDIT balance. Keep the credit gates below set to DENY on
# staging unless you are DELIBERATELY testing credit spend, so staging testing
# never silently drains prod's Scrydex credits.
POKEWALLET_API_KEY=""
SCRYDEX_API_KEY=""
SCRYDEX_TEAM_ID=""

# Leave DENY (blank/"false") on staging unless deliberately testing credit spend.
SCRYDEX_LIVE_CREDITS_APPROVED=""

# Leave OFF (blank/"false") on staging unless deliberately testing on-view spend.
SCRYDEX_ONVIEW_ENABLED=""

# Optional Typesense search. Shareable with prod if used.
SEARCH_ENGINE=""
TYPESENSE_URL=""
TYPESENSE_SEARCH_API_KEY=""
TYPESENSE_ADMIN_API_KEY=""
TYPESENSE_COLLECTION="cards"
TYPESENSE_TIMEOUT_MS="1500"

# -------------------------------------------------------------
# RATE LIMITING
# -------------------------------------------------------------
# Same semantics/defaults as prod.
RATELIMIT_CREDIT_PER_MIN="10"
RATELIMIT_AUTH_PER_MIN="10"
RATELIMIT_SEARCH_PER_MIN="60"
