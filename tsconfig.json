{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // vitest/playwright config files are excluded from Next's build-time
  // type-check: their bundled Vite/Vitest Plugin types conflict and are
  // irrelevant to the app build (they run under their own toolchains).
  "exclude": [
    "node_modules",
    "scripts",
    "prisma/seed.ts",
    "prisma/seed-test.ts",
    "prisma/drafts",
    "vitest.config.ts",
    "playwright.config.ts"
  ]
}
