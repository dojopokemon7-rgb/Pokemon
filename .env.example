# ──────────────────────────────────────────────────
#  Pokémon TCG Seeder — Environment Variables
#  Copy this file to .env and fill in real values.
# ──────────────────────────────────────────────────

# ── Pokémon TCG API ────────────────────────────────
# Get a free key at https://pokemontcg.io/
POKEMON_TCG_API_KEY=your_api_key_here

# ── PostgreSQL Connection ──────────────────────────
# Option A: individual fields (recommended for local / Docker)
PGHOST=localhost
PGPORT=5432
PGDATABASE=pokemon_tcg
PGUSER=postgres
PGPASSWORD=your_password_here

# Option B: single connection string (uncomment to use instead)
# DATABASE_URL=postgresql://user:password@host:5432/pokemon_tcg

# Append ?sslmode=require for Supabase / Railway / Neon / Render:
# DATABASE_URL=postgresql://user:password@host:5432/pokemon_tcg?sslmode=require

# ── Google Cloud Vision API (OCR) ──────────────────
# Path to your Google Cloud service account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=your_key_path_here.json

# ── Seed Tuning (optional overrides) ──────────────
# How many ms to wait between API page requests (default 200)
SEED_DELAY_MS=200

# How many cards to insert per SQL statement (default 500)
SEED_BATCH_SIZE=500

# Max retries per page on transient errors (default 3)
SEED_MAX_RETRIES=3

# Set to "true" to fetch pages but skip DB writes (dry run)
DRY_RUN=false
