# =============================================================
# TCG Collection PWA — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git.
# =============================================================

# -------------------------------------------------------------
# DATABASE (Supabase PostgreSQL)
# -------------------------------------------------------------
# Pooled connection string (PgBouncer) — used by Prisma at runtime.
# Found in: Supabase Dashboard → Project Settings → Database → Connection String
# Mode: Transaction (Port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection string — used by Prisma for migrations (bypasses PgBouncer).
# Mode: Session (Port 5432)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# -------------------------------------------------------------
# REDIS
# -------------------------------------------------------------
# Docker Compose: use the service name 'redis' as the host.
# Local dev (no Docker): use localhost.
REDIS_URL="redis://redis:6379"

# Alternative Redis URL env name. The app reads `REDIS_URL ?? STORAGE_REDIS_URL`
# (src/lib/redis.ts), so a managed provider that injects STORAGE_REDIS_URL (e.g.
# Vercel's Upstash integration) works without setting REDIS_URL. Optional — leave
# unset if you set REDIS_URL. Redis is optional overall; a cache outage never fails
# a request.
# STORAGE_REDIS_URL=""

# Redis AUTH password. Required by docker-compose (redis-server --requirepass
# ${REDIS_PASSWORD}) and embedded in the app's REDIS_URL
# (redis://default:${REDIS_PASSWORD}@redis:6379). Redis is optional, so a cache
# outage never fails a request — but when it IS up it must require this password.
# REDIS_PASSWORD=""

# -------------------------------------------------------------
# BETTER AUTH
# -------------------------------------------------------------
# Generate with: openssl rand -base64 32
# Or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET="REPLACE_WITH_A_32_CHARACTER_RANDOM_SECRET"

# The public URL of the app (used by Better Auth to set cookies and redirects).
# Local: http://localhost:3000
# Production: https://your-domain.com
BETTER_AUTH_URL="http://localhost:3000"

# Public app URL used for SSR metadata base, the "/" → /login redirect, and the
# auth client's SSR base URL (client-side it uses window.location.origin). Read
# as process.env.NEXT_PUBLIC_APP_URL; unset falls back to http://localhost:3000.
# Set to your production origin in prod, e.g. https://your-domain.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth (social sign-in) — Better Auth google provider (src/lib/auth.ts).
# Create credentials at https://console.cloud.google.com → APIs & Services →
# Credentials → OAuth client ID (Web application). Add the authorized redirect
# URI <BETTER_AUTH_URL>/api/auth/callback/google. Unset defaults to "test"
# (OAuth disabled / non-functional) — set real values to enable Google sign-in.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Public domain for the Nginx production server block (${DOMAIN}) and the
# staging block (staging.${DOMAIN}) — REQUIRED by the nginx service (compose
# fails with "DOMAIN must be set for nginx" if unset; for local dev use
# `npm run dev`). docker-compose.yml passes it into the nginx container, whose
# envsubst renders it into infra/nginx/templates/10-dojo.conf.template.
# IMPORTANT: set it UNQUOTED — a quoted value is substituted literally and
# nginx would match the string with quotes, which never matches a real Host.
# e.g.  DOMAIN=your-domain.com   (not  DOMAIN="your-domain.com")
# DOMAIN=

# STAGING basic-auth hash for the Nginx staging block (staging.${DOMAIN}).
# docker-compose.yml passes it into the nginx container and scripts/start.sh
# writes it to the htpasswd file as `staging:<hash>` — resolved by compose
# variable-substitution from THIS root .env (the SAME source as DOMAIN above;
# the nginx service has no env_file, so .env.staging is NOT consulted).
# Keeping the real hash here, in the gitignored .env, means `git reset --hard`
# deploys never clobber it.
# Generate the hash (quote the password). Recommended (apr1, cheap to verify on
# every request):
#   docker run --rm alpine sh -c "apk add -q openssl && openssl passwd -apr1 '<password>'"
# bcrypt ($2a/$2b/$2y) is also accepted (the old
# `docker run --rm caddy:2-alpine caddy hash-password --plaintext '<password>'`
# output still works) but nginx re-verifies on EVERY request, so a high cost
# (e.g. 14) burns ~1s CPU per request; prefer apr1 or cost <= 10.
# ESCAPE EVERY `$` AS `$$` in this file: compose interpolates `$name` in .env
# (an unescaped hash is silently truncated). So  $apr1$salt$hash  is written
#   STAGING_BASICAUTH_HASH=$$apr1$$salt$$hash
# Empty/unset = staging basic-auth fails closed (no valid credential).
# PLACEHOLDER below — replace it.
# STAGING_BASICAUTH_HASH=$$apr1$$REPLACE$$WITH_APR1_HASH
# PSA Public API token (F-17 graded pricing). Free token from
# https://www.psacard.com/publicapi (100 calls/day). Used as a bearer token
# to verify PSA cert numbers; when unset, graded pricing uses the curated
# fallback table. Read as process.env.PSA_API_KEY.
PSA_API_KEY=""

# -------------------------------------------------------------
# ADMIN AUTH (isolated superuser — env-defined, NOT the DB)
# -------------------------------------------------------------
# The single admin is defined HERE, not by the DB `isAdmin` column (which is
# RETIRED as an auth source — see scripts/revoke-all-admins.ts). Admin logs in
# ONLY at /admin: email + password (compared server-side in constant time) THEN
# a MANDATORY 6-digit email OTP sent to ADMIN_EMAIL on EVERY login. A correct
# OTP mints an isolated, Better-Auth-decoupled admin session: a signed httpOnly
# + SameSite=Strict + Secure(prod) cookie (`dojo_admin_session`) carrying an
# HMAC-signed {exp} with a 4-HOUR lifetime, re-validated on every admin request.
# These are read SERVER-SIDE ONLY and never reach the client bundle. Leave them
# BLANK here — real values live in .env (never committed).
#
# ponytail: the login OTP + pending-login state is an in-memory Map keyed by a
# per-login nonce — correct for ONE admin on ONE Node instance (the documented
# deployment). Upgrade path for multi-instance: move that store to Redis.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional dedicated secret for signing the admin session cookie. If unset the
# admin session falls back to BETTER_AUTH_SECRET. Generate with:
#   openssl rand -base64 32
ADMIN_SESSION_SECRET=

# RETIRED: previously the bootstrap-admin password for scripts/create-admin.ts.
# DB admins are no longer an auth source (run scripts/revoke-all-admins.ts to
# strip the stale flag). Kept only so an existing .env doesn't error; unused.
ADMIN_INITIAL_PASSWORD=your_secure_password_here

# Signup allowlist — gates NEW account creation (email/password AND Google
# OAuth) at the Better Auth user.create.before hook. Comma-separated exact
# emails and/or @domain.com suffixes, e.g.
#   SIGNUP_ALLOWLIST="me@example.com,@trusted.org"
# Empty/unset = OPEN (anyone may sign up). Gates creation only, not sign-in.
SIGNUP_ALLOWLIST=""

# -------------------------------------------------------------
# GOOGLE CLOUD VISION (F-14 Card Scanner OCR)
# -------------------------------------------------------------
# Enable the Vision API in your Google Cloud project, then create an API key
# (APIs & Services → Credentials → Create credentials → API key). Used by the
# scanner's OCR step (Vision TEXT_DETECTION); when unset the scanner falls
# back to on-device tesseract.js. Read as process.env.GOOGLE_VISION_API_KEY.
GOOGLE_VISION_API_KEY=""

# Lifetime successful-scan allowance per user (User.scanCount). Read by
# src/lib/utils/scan-limit.ts; unset falls back to DEFAULT_SCAN_LIMIT (10).
# Raise to grant more scans before the limit blocks further Vision calls.
# SCAN_LIMIT="10"

# -------------------------------------------------------------
# SUPABASE (Client-side Storage / File Uploads — Week 3+)
# -------------------------------------------------------------
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# -------------------------------------------------------------
# SMS PROVIDER (Week 4 — OTP via Phone)
# -------------------------------------------------------------
# Leave blank in local dev. When populated, the auth module will
# send real SMS via the configured provider instead of logging to console.
# See: src/lib/auth.ts → phoneNumber plugin → sendOTP
SMS_PROVIDER_API_KEY=""
SMS_PROVIDER_BASE_URL=""
SMS_FROM_NUMBER=""

# -------------------------------------------------------------
# EMAIL SENDER (ALL customer-facing email: OTP, password reset, contact, reminders)
# -------------------------------------------------------------
# Every email is sent through Amazon SES (src/lib/utils/ses-email.ts) with
# From = EMAIL_FROM. Password reset (src/lib/utils/reset-email.ts) uses the SAME
# SES client, so it needs AWS_SES_REGION + AWS_SES_ACCESS_KEY_ID +
# AWS_SES_SECRET_ACCESS_KEY + EMAIL_FROM, exactly like the OTP email. Unset in
# local dev -> the reset link / OTP is logged to the console (dev only); unset in
# prod -> a loud, link-free server error (links/codes are NEVER logged in prod).
# EMAIL_FROM must be a verified SES identity, e.g. hello@dojocollect.com.
EMAIL_FROM=""
AWS_SES_REGION=""
AWS_SES_ACCESS_KEY_ID=""
AWS_SES_SECRET_ACCESS_KEY=""
# LEGACY, optional: Resend is used for password reset ONLY when SES is not
# configured. Prefer SES; leave empty. (EMAIL_PROVIDER_API_KEY /
# EMAIL_PROVIDER_BASE_URL were removed: they were never honoured.)
RESEND_API_KEY=""
#
# CONTACT FORM (public landing /contact -> POST /api/contact). Sent through the SES
# settings above (EMAIL_FROM = From, visitor = Reply-To). Without AWS_SES_* the form
# answers 500 (never a fake success).
# Inbox that receives the messages (default dojo.collect@nodwin.com).
CONTACT_TO_EMAIL="dojo.collect@nodwin.com"
# Optional: explicit subject prefix, e.g. "[STAGING]". Unset = auto: "[STAGING] " is added
# when NEXT_PUBLIC_APP_URL / BETTER_AUTH_URL has a host containing "staging".
CONTACT_SUBJECT_PREFIX=""

# -------------------------------------------------------------
# APITCG (Real One Piece card data)
# -------------------------------------------------------------
# Register at https://apitcg.com/platform for a free API key.
# Used by src/lib/services/card.service.ts → fetchApiTcgOnePiece
# Sent as the `x-api-key` request header on every call.
APITCG_API_KEY=""

# -------------------------------------------------------------
# eBay Sandbox / Production API (Price Comparison & Deal Finder)
# -------------------------------------------------------------
# Register at https://developer.ebay.com/my/keys.
# Client Credentials OAuth flow uses only CLIENT_ID + CLIENT_SECRET.
# EBAY_API_URL:
#   - Sandbox:    https://api.sandbox.ebay.com
#   - Production: https://api.ebay.com
EBAY_CLIENT_ID=""
EBAY_CLIENT_SECRET=""
EBAY_DEV_ID=""
EBAY_RU_NAME=""
EBAY_API_URL="https://api.sandbox.ebay.com"

# eBay Marketplace Account Deletion/Closure notification endpoint (REQUIRED by
# eBay for production API access). Read by
# src/app/api/ebay/marketplace-account-deletion/route.ts to answer eBay's
# challenge-code validation. Both are set here AND pasted into the eBay
# developer dashboard; they must match exactly.
#   EBAY_MARKETPLACE_DELETION_TOKEN     — a 32-80 char verification token you choose
#   EBAY_MARKETPLACE_DELETION_ENDPOINT  — the exact public URL of that route,
#                                         e.g. https://your-domain.com/api/ebay/marketplace-account-deletion
EBAY_MARKETPLACE_DELETION_TOKEN=""
EBAY_MARKETPLACE_DELETION_ENDPOINT=""

# -------------------------------------------------------------
# CRON JOBS
# -------------------------------------------------------------
# Required on Vercel. Sent by Vercel Cron as
#   Authorization: Bearer $CRON_SECRET
# and validated (constant-time, fail-closed in production) by the cron routes:
#   - /api/cron/refresh-owned-prices  (daily 03:00 UTC) — refreshes CURRENT
#     price for the OWNED-cards set only (distinct active holdings across all
#     users). History/population stay on the on-view 7-day cadence (unchanged).
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# Per-run cap for the daily owned-price refresh — the max number of owned cards
# handed to the pool in one run. Unset = 250 (default). Owned cards beyond the
# cap wait for the next daily run; the pricing service's built-in 24h freshness
# gate keeps already-priced cards cheap, so the backlog drains over days.
DAILY_OWNED_PRICE_CAP=""

# -------------------------------------------------------------
# POKEMON TCG API (Daily Sync Engine)
# -------------------------------------------------------------
# Optional. Free tier (30 req/min) works unauthenticated, but a key
# raises the limit to 20,000/day. Register at https://pokemontcg.io/.
# Sent as `X-Api-Key`.
POKEMON_TCG_API_KEY=""

# -------------------------------------------------------------
# POKEWALLET & SCRYDEX (API Integrations)
# -------------------------------------------------------------
POKEWALLET_API_KEY=""
SCRYDEX_API_KEY=""
SCRYDEX_TEAM_ID=""

# Big-bulk credit gate (price-history / Vision / listings / bulk refresh).
# Unset/"false" = DENY (default); "true" lets credit-consuming Scrydex paths spend.
SCRYDEX_LIVE_CREDITS_APPROVED=""

# On-view enrichment allowance — SEPARATE from the bulk gate above. When "true",
# the card-detail enrich + eBay-sold POST routes may spend on-view Scrydex
# credits (price_history 3, population 1, listings 1) the first time a card is
# viewed. Unset/"false" = no on-view spend (both routes become honest no-ops).
SCRYDEX_ONVIEW_ENABLED=""

# Optional Typesense search (Epic A). Unset SEARCH_ENGINE = PostgreSQL ranker only.
SEARCH_ENGINE=""
TYPESENSE_URL=""
# Search-only key (server runtime). The admin key is for scripts/backfill-search-index.ts ONLY.
TYPESENSE_SEARCH_API_KEY=""
TYPESENSE_ADMIN_API_KEY=""
TYPESENSE_COLLECTION="cards"
TYPESENSE_TIMEOUT_MS="1500"

# -------------------------------------------------------------
# ANALYTICS (PostHog)
# -------------------------------------------------------------
# These are PUBLIC client keys (NOT secrets) — Next inlines every NEXT_PUBLIC_*
# into the browser bundle by design. PostHog is a TOTAL no-op when its key
# is unset/blank (no script, no network) AND only ever loads AFTER the user
# clicks "Accept" on the cookie-consent banner (localStorage-gated).
#
# BUILD-TIME CAVEAT (critical for Docker/standalone): because NEXT_PUBLIC_* are
# inlined at `next build` time — NOT read at runtime — these MUST be present in
# the root .env BEFORE `docker compose up --build`, or PostHog silently
# never load in the image even with keys in .env. docker-compose.yml passes them
# as build args and the Dockerfile re-declares them as ARG/ENV before the build.
# See docs/ANALYTICS_SETUP.md for the exact operator sequence.
#
# PostHog project API key (starts with phc_). Get it in PostHog →
# Project Settings → Project API Key.
NEXT_PUBLIC_POSTHOG_KEY=""
# PostHog ingestion host. US cloud: https://us.i.posthog.com
# EU cloud: https://eu.i.posthog.com (or your self-hosted URL).
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"
# Optional exact PostHog project dashboard URL for the admin "External
# Analytics" card. If unset the card links to NEXT_PUBLIC_POSTHOG_HOST.
NEXT_PUBLIC_POSTHOG_DASHBOARD_URL=""
# SERVER-ONLY (not NEXT_PUBLIC). exchangerate.host API key, used by
# src/lib/services/fx.service.ts for GET /api/fx/usd-inr, which supplies the real
# USD->INR rate for the PostHog `value_inr` property. exchangerate.host-style
# providers now REQUIRE a key (keyless calls return HTTP 401). Leave blank and
# INR is simply OMITTED from events (never guessed); value_usd is always sent.
EXCHANGE_RATE_API_KEY=""
# STAGING ONLY: a SEPARATE PostHog project for the staging container so tester
# traffic never pollutes production metrics. docker-compose.yml feeds these to
# the app-staging BUILD (compose reads the root .env, not .env.staging). Unset =
# analytics is a no-op on staging (it no longer reuses the production key).
STAGING_NEXT_PUBLIC_POSTHOG_KEY=""
STAGING_NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"
STAGING_NEXT_PUBLIC_POSTHOG_DASHBOARD_URL=""

# -------------------------------------------------------------
# RATE LIMITING
# -------------------------------------------------------------
# Redis-backed, per-IP (unauthenticated) / per-user (authenticated), FAIL-OPEN
# rate limits (src/lib/utils/rate-limit.ts). Protect Scrydex credits, the DB
# pool, and the login endpoint from abusive bursts. Each value is a per-MINUTE
# count; unset = the baked-in default. Backed by the OPTIONAL Redis cache
# (AGENTS.md RULE 1): a Redis outage DISABLES limiting (fail-open), it NEVER
# blocks a request.
#
# VERY TIGHT — Scrydex-credit routes, per USER (recognize/Vision, [id]/enrich,
# cards/reprice, [id]/ebay-sold POST, users/me/portfolio/refresh).
RATELIMIT_CREDIT_PER_MIN="10"
# TIGHT — auth sign-in / sign-up, per IP (brute-force cap; get-session is never
# limited).
RATELIMIT_AUTH_PER_MIN="10"
# MODERATE — card search, per user if authenticated else per IP.
RATELIMIT_SEARCH_PER_MIN="60"
# TIGHT — public contact form (sends an email), per IP.
RATELIMIT_CONTACT_PER_MIN="3"

# ANALYTICS DASHBOARD (admin /admin/analytics) — SERVER-ONLY, runtime env (no rebuild).
# Create under PostHog Settings > Personal API keys with the 'Query read' scope.
# NEVER prefix with NEXT_PUBLIC_. Unset = admin shows 'Analytics not configured'.
# Add to BOTH .env (prod) and .env.staging, then recreate the container.
POSTHOG_PERSONAL_API_KEY=""
POSTHOG_PROJECT_ID="333915"
POSTHOG_API_HOST="https://eu.posthog.com"

# -------------------------------------------------------------
# SCRYDEX RENEWAL + LOW-CREDIT REMINDERS (server-only; see docs/SCRYDEX_REMINDERS.md)
# -------------------------------------------------------------
# Emails SCRYDEX_REMINDER_TO before each manual renewal (the Amex card does not
# auto-renew) and when credits run low. Triggered daily by the host crontab
# calling GET /api/cron/scrydex-reminder. Invalid values never crash the app:
# the job reports "not configured / invalid: <reason>" and sends nothing.
# Only "true" enables; anything else = disabled (keep OFF on staging).
SCRYDEX_REMINDER_ENABLED="false"
# Any renewal date (YYYY-MM-DD), past is fine - the app rolls it forward.
SCRYDEX_RENEWAL_DATE=""
# monthly | yearly (default monthly). Same day-of-month each cycle; clamped to
# the month's last day (31 Jan -> 28/29 Feb -> 31 Mar).
SCRYDEX_RENEWAL_CYCLE="monthly"
# IANA timezone that defines "today" (default Asia/Kolkata).
SCRYDEX_REMINDER_TZ="Asia/Kolkata"
# Days before renewal to email; 0 = renewal day (default 7,3,1,0).
SCRYDEX_REMINDER_DAYS_BEFORE="7,3,1,0"
# Low-credit alerts: percent remaining at/below which to email, once per
# threshold per billing cycle (default 20,5). Empty string disables.
# NOTE: reading usage costs 1 Scrydex credit, so it needs SCRYDEX_LIVE_CREDITS_APPROVED=true.
SCRYDEX_LOW_CREDIT_PERCENT="20,5"
# Comma-separated recipients (default dojo.collect@nodwin.com).
SCRYDEX_REMINDER_TO="dojo.collect@nodwin.com"
# Optional plan name shown in the email (max 80 chars).
SCRYDEX_PLAN_LABEL=""
