// =============================================================
// Prisma Schema — TCG Collection PWA
// Provider: PostgreSQL (Supabase, remote)
// =============================================================
// ARCHITECTURE NOTES:
// - `url`         → pooled PgBouncer connection (runtime queries)
// - `directUrl`   → direct Postgres connection (migrations only)
//   This is required when using Supabase's PgBouncer in Transaction
//   mode because PgBouncer does not support prepared statements used
//   by Prisma's migration engine.
// =============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =============================================================
// BETTER AUTH MODELS
// These are the EXACT models required by Better Auth + Prisma adapter.
// DO NOT rename fields — Better Auth expects these exact names.
// Ref: https://www.better-auth.com/docs/adapters/prisma
// =============================================================

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Extended field for Mobile OTP (Better Auth phoneNumber plugin)
  // Populated when a user links/verifies their phone number.
  phoneNumber         String?  @unique
  phoneNumberVerified Boolean? @default(false)

  // Grants access to the internal Admin Panel.
  isAdmin Boolean @default(false)

  // Scanner lifetime allowance (plan: 10 SUCCESSFUL matches total, not per month).
  // Incremented ONLY on a successful Scrydex Vision identification, via an atomic
  // conditional update so concurrent scans can never overrun the limit. Configurable
  // ceiling lives in config/env (SCAN_LIMIT), not here. A failed/no-match scan does
  // NOT increment this.
  scanCount Int @default(0)

  // Account-persisted onboarding completion (first-signup Continue/Skip). Null = not
  // completed; a timestamp = completed. Persisted on the account so the step never
  // reappears across devices.
  onboardingCompletedAt DateTime?

  // Display currency for CURRENT-price conversion (plan §2). "USD" | "EUR". Chart
  // history points are always rendered source-native and never converted; only the
  // current-price display is converted into this currency. Defaults to USD.
  displayCurrency String @default("USD")

  // Relations
  sessions         Session[]
  accounts         Account[]
  collections      UserCollection[]
  namedCollections Collection[]
  supportTickets   SupportTicket[]
  wantList         WantListItem[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  // Relation back to User
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

// =============================================================
// TCG DOMAIN MODELS
// =============================================================

enum Game {
  POKEMON
  ONE_PIECE

  @@map("game")
}

enum DataSource {
  TCGDEX
  POKEWALLET
  SCRYDEX

  @@map("data_source")
}

// Represents a TCG product set/expansion (e.g., "Scarlet & Violet Base Set")
model CardSet {
  id           String    @id @default(cuid())
  externalId   String    @unique // ID from the external TCG API (e.g., Pokemon TCG API)
  name         String
  series       String?
  printedTotal Int? // Number of cards printed in the set
  total        Int? // Total cards including secret rares
  releaseDate  DateTime?
  symbolUrl    String?
  logoUrl      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  cards Card[]

  // Search's F-06 set filter matches `set: { name: { equals, insensitive } }`
  // and the filter dropdown lists set names; index the column those hit.
  @@index([name])
  @@map("card_set")
}

// Represents an individual TCG card
model Card {
  id         String     @id @default(cuid())
  game       Game       @default(POKEMON)
  source     DataSource @default(TCGDEX)
  externalId String     @unique // ID from the external TCG API
  // Scrydex-native card id (e.g. "me55c-4"), cached after resolveScrydexCard
  // resolves it by name+number+set. Distinct from externalId (TCGdex id /
  // Bandai code) — Scrydex uses its OWN id namespace, so a resolved id is
  // persisted here to skip the search on subsequent pulls (one credit, no
  // re-matching). Nullable: a card that never resolves simply stays null.
  scrydexId  String?    @unique
  name       String
  number     String // Card number within the set (e.g., "001/165")
  rarity     String?
  types      String[] // Comma-separated or JSON array (e.g., ["Fire", "Normal"])
  // Searchable keyword tags built from card/set metadata (types, rarity,
  // set series, etc.) by scripts/backfill-tags.ts + the seed. Powers the
  // multi-field search `OR` (name/number/set/tags).
  tags       String[]   @default([])
  imageUrl   String?
  imageUrlHi String? // High-res image URL

  // Pricing snapshot (latest market price cache).
  //   marketPrice   = last-known "Dojo Value" (our aggregated market price)
  //   lastEbayPrice = last-known eBay price (F-16). Both are the cache the
  //                   price-sources aggregator falls back to when a live
  //                   source fetch fails, so a stale number can still show.
  marketPrice   Float?
  lastEbayPrice Float?
  lastPricedAt  DateTime?

  // Weekly price change (plan §4 — weekly abs + pct for filters/sorting;
  // daily/monthly deferred). Populated from the REAL Scrydex 7-day trend delta
  // (trends.days_7) when a price is pulled — never fabricated. Null until a
  // priced pull runs. Stored as columns (not computed) so Postgres can ORDER BY.
  weeklyChangeAbs Float?
  weeklyChangePct Float?

  // Relations
  setId String
  set   CardSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  userCollections UserCollection[]
  pricingHistory  PricingHistory[]
  currentPrices   CurrentPrice[]
  syncLogs        SyncLog[]
  populationReports PopulationReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([setId])
  @@index([name])
  // Trending endpoint orders by `updatedAt desc` over the whole
  // catalog; without this index the sync's daily writes force a full
  // sequential scan on every trending fetch.
  @@index([updatedAt])
  // Search matches `tags: { has: <query> }` on every keyword search. A GIN
  // index is the structure Postgres uses for array membership; without it
  // the `has` predicate is a sequential scan of the whole catalog.
  @@index([tags], type: Gin)
  @@map("card")
}

// A named, user-owned grouping of cards (F-10). A user has many; cards are
// filed into one via UserCollection.collectionId (null = uncategorized).
enum CollectionType {
  POKEMON
  ONE_PIECE
  MIXED

  @@map("collection_type")
}

model Collection {
  id        String         @id @default(cuid())
  userId    String
  name      String
  isPrivate Boolean        @default(true)
  typeTag   CollectionType @default(MIXED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     UserCollection[]
  wantItems WantListItem[] // F-#8 back-relation for collection-scoped want lists

  @@unique([userId, name]) // no two same-named collections per user
  @@index([userId])
  @@map("collection")
}

// Represents a user's card collection entry (one row per card owned)
model UserCollection {
  id                   String    @id @default(cuid())
  userId               String
  cardId               String
  quantity             Int       @default(1) // How many copies the user owns
  condition            String? // e.g., "Near Mint", "Lightly Played"
  notes                String?
  isFoil               Boolean   @default(false)
  // Price the user actually paid per copy, captured at add-time. Distinct
  // from Card.marketPrice (the live/cached market value) — this is what
  // "Paid" / "Realized" / "Unrealized" stats on the dashboard are computed
  // against. Nullable because a user can add a card without recording a
  // purchase price (defaults to the card's market price at add-time).
  purchasePrice        Float?
  // Cost-basis provenance (plan §5): the amount in purchasePrice is paired with the
  // SOURCE it came from ("user" | "add-snapshot" | "scrydex-history" | ...), the
  // CURRENCY it was captured in, and WHEN a resolution was last attempted. A null
  // purchasePrice WITH a costBasisAttemptedAt timestamp = UNRESOLVED (we tried, no
  // usable price) and must surface as "unresolved" P&L, never a fabricated 0.
  costBasisSource      String?
  costBasisCurrency    String?
  costBasisAttemptedAt DateTime?
  addedAt              DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Sold tracking (Collectr portfolio feature). A partial sale SPLITS the row: the
  // sold quantity moves to a new row with isSold=true (same collectionId, preserved
  // association), the remainder stays active. soldPrice is the GROSS proceeds for this
  // sold row's quantity (gross-per-copy * quantity); soldCurrency records its currency.
  isSold       Boolean   @default(false)
  soldPrice    Float?
  soldCurrency String?
  soldAt       DateTime?

  // Optional membership in a named Collection (F-10). Null = the user's
  // default/uncategorized set. SetNull so deleting a collection unfiles
  // its cards rather than deleting the owned-copy rows.
  collectionId String?
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  // F-#8 per-variant uniqueness is enforced by the partial expression index
  // `uc_variant_coalesced` (migration): UNIQUE(userId, COALESCE(collectionId,''),
  // cardId, isFoil, COALESCE(condition,'')) WHERE isSold=false. NOT a Prisma
  // @@unique — a plain one is NULL-distinct (won't dedupe loose lots) and non-partial
  // (would reject repeated sold lots). `condition` holds the graded label ("PSA 10")
  // or raw-condition string; a raw lot and a PSA 10 lot of the same card in the same
  // collection are TWO distinct rows (different `condition`).

  @@index([userId])
  @@index([cardId])
  @@index([collectionId])
  // Serves the hot `where userId + orderBy addedAt desc` read issued by the
  // dashboard SSR, portfolio, and the collection GET — the largest-payload
  // queries on the first-byte-critical path. Without it Postgres filters on
  // the userId index then sorts the matched rows every time; the composite
  // lets the sort be index-ordered (same rationale as Card.@@index([updatedAt])
  // serving trending).
  @@index([userId, addedAt])
  @@map("user_collection")
}

// A card a user has favorited ("tracked" / starred). Distinct from
// =============================================================
// AUDIT LOG
// =============================================================
// Records every mutating admin action for security review.
// Written via a helper from server actions / API routes; read-only
// from the app itself.
model AuditLog {
  id         String   @id @default(cuid())
  adminId    String // User.id of the admin who performed the action
  adminEmail String // Denormalized so log survives user deletion
  action     String // e.g. "card.update_price", "user.ban"
  targetType String // "card" | "user" | "listing" | ...
  targetId   String?
  details    Json? // Free-form context: before/after values, reason, etc.
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_log")
}

// Historical pricing data for market trend analysis
model PricingHistory {
  id             String   @id @default(cuid())
  cardId         String
  priceMarket    Float?
  priceLow       Float?
  source         String
  currency       String   @default("USD")
  // Original source-native currency of the point as returned by the provider. Charts
  // render source-native and are NEVER FX-converted (plan §2). Backfill legacy rows =
  // currency. Kept distinct so a later display-currency column can't overwrite it.
  sourceCurrency String?
  variant        String   @default("normal")
  condition      String   @default("NM")
  recordedAt     DateTime @default(now())

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([cardId, recordedAt, source, currency, variant, condition])
  @@index([cardId, recordedAt])
  @@map("pricing_history")
}

// Current prices for fast reads
model CurrentPrice {
  id          String     @id @default(cuid())
  cardId      String
  source      DataSource
  currency    String     @default("USD")
  variant     String     @default("normal")
  condition   String     @default("NM")
  // C1: full price capture — every Scrydex variants[].prices[] entry becomes a row.
  company     String?    // null for raw; "PSA"|"CGC"|"BGS"|"TAG" for graded
  grade       String?    // null for raw; "10"|"9"|"8.5"|"9Q" etc. for graded (verbatim)
  type        String     @default("raw") // "raw" | "graded"
  priceMarket Float?
  priceLow    Float?
  updatedAt   DateTime   @updatedAt

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([cardId, source, currency, variant, condition, company, grade, type])
  @@index([cardId])
  @@map("current_price")
}

// Sync bookkeeping
model SyncLog {
  id      String   @id @default(cuid())
  job     String // 'tcgdex_catalog' | 'scrydex_history'
  cardId  String?
  status  String // 'ok' | 'failed'
  credits Int      @default(0)
  error   String?
  ranAt   DateTime @default(now())

  card Card? @relation(fields: [cardId], references: [id], onDelete: SetNull)

  @@index([job, ranAt])
  // Backs the Scrydex freshness-gate lookup
  // `where { job, cardId } orderBy { ranAt desc }` (scrydex-pricing.service.ts).
  // Without it the cardId filter would scan — [job, ranAt] alone can't serve it.
  @@index([job, cardId, ranAt])
  @@map("sync_log")
}

// PSA English population report per card (Scrydex include=pop_reports).
// PLAN CONSTRAINT: Scrydex public population coverage is Pokémon PSA English
// ONLY (docs/SCRYDEX_AUDIT.md Area 4b). BGS is UNSUPPORTED and is NEVER stored
// here (BGS_POPULATION_SUPPORTED stays false). We NEVER fabricate counts — a
// card with no refreshed report simply has no row (read returns null → UI
// honest fallback). Populated ONLY by the manual, owner-approval-gated
// pullAndStorePopulation; never on page load / search / sync.
model PopulationReport {
  id          String   @id @default(cuid())
  cardId      String
  source      String   @default("scrydex") // always "scrydex" when present
  company     String   @default("PSA")     // PSA only (BGS never stored)
  language    String   @default("English") // Scrydex public = English only
  // JSON array of { grade, count } across GRADE_LADDER (10..1.5,1,Auth). JSON
  // (not a child table) because it is read/written as one whole report blob
  // and re-parsed through Zod on read (RULE 4) — a child table would add joins
  // for no query we run. Prisma type: Json.
  grades      Json
  total       Int
  refreshedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  // One CURRENT report per card/source/company/language → upsertable key.
  @@unique([cardId, source, company, language])
  @@index([cardId])
  @@map("population_report")
}

// =============================================================
// SUPPORT TICKETS (F-21 Contact Support)
// =============================================================
enum TicketStatus {
  OPEN
  RESOLVED

  @@map("ticket_status")
}

// A support message submitted via the Contact Support form. `userId` is
// nullable so the model also supports anonymous submissions later; today
// the form is gated to logged-in users and stamps their id. Persisting
// tickets (rather than emailing) gives us an admin queue to build on.
model SupportTicket {
  id        String       @id @default(cuid())
  userId    String?
  name      String
  email     String
  subject   String
  message   String
  status    TicketStatus @default(OPEN)
  createdAt DateTime     @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("support_ticket")
}

// =============================================================
// WANT LIST (F-07 — replaces the Binders stub)
// =============================================================
// A user's wishlist of cards they want to Buy / Sell / Trade. `cardId` is
// the EXTERNAL API card id (e.g. "base1-4", "OP01-001") — the same
// identifier used across the search/detail flow — not a FK to Card, so a
// card can be wanted before it's ever persisted in the local catalog.
enum WantIntent {
  BUY
  SELL
  TRADE

  @@map("want_intent")
}

model WantListItem {
  id        String     @id @default(cuid())
  userId    String
  cardId    String // external card id
  intent    WantIntent
  createdAt DateTime   @default(now())

  // F-#8: scope a want item to a named collection. Null = legacy account-level
  // (the pre-migration global list) and surfaces under the top-level All view.
  // SetNull mirrors UserCollection.collectionId: deleting a collection unfiles
  // its want items to account-level rather than destroying them.
  collectionId String?
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Same card+intent can live once per collection (and once at the null/account
  // scope). The REAL uniqueness is the COALESCE expression index `wli_scope_coalesced`
  // (migration), which Postgres cannot express in Prisma schema. We DELIBERATELY do
  // NOT declare `@@unique([userId, cardId, intent, collectionId])` here: a plain Prisma
  // @@unique is NULL-DISTINCT (does not dedupe account-level null rows) AND would
  // generate a second, redundant unique index that collides with the expression one.
  // The service uses findFirst+create (NOT upsert ON CONFLICT) so no compound Prisma
  // key name is needed.
  // Retained: the new [userId, collectionId, intent] index below cannot serve an
  // intent-only (collectionId omitted = all scopes) query as a left-prefix — its
  // second column is collectionId — so the back-compat intent-only
  // `where:{ userId, intent }` still needs this [userId, intent] index.
  @@index([userId, intent])
  // Serves the new per-collection want queries (GET ?collectionId=…).
  @@index([userId, collectionId, intent])
  @@map("want_list_item")
}

// =============================================================
// SCAN FEEDBACK (F-14 — recognition tuning loop)
// =============================================================
// One row per completed scan: the OCR text, the ranked candidates we
// offered, and the card the user actually picked (null if they abandoned
// or searched manually). This is the ground-truth dataset for tuning the
// scoring weights in card-recognition.service.ts later — we never guess at
// weights, we measure against what users confirmed.
model ScanFeedback {
  id           String   @id @default(cuid())
  userId       String? // null for anonymous / unauthenticated scans
  ocrText      String // raw OCR output the engine scored
  ocrSource    String   @default("vision") // "vision" | "tesseract" | "manual"
  // The ranked candidates shown to the user: [{ id, name, set, confidence }].
  candidates   Json
  // externalId of the card the user confirmed; null = none picked yet.
  pickedCardId String?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([pickedCardId])
  @@index([createdAt])
  @@map("scan_feedback")
}
